#include "kona-moorechip-common.dtsi"

&kona_qrd_batterydata {
	#include "fg-gen4-batterydata-7717264-quectel-sg865w-5000mah.dtsi"
};

&joystick {
	moorechip,layout-nintendo;
};

&soc {
	hal_wakeup_gpio {
		compatible = "hal_wakeup";
		hal-gpio = <&tlmm 123 0x00>;
	};
};

